{
  "expo": {
    "name": "HIME STUDIO",
    "slug": "hime-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "himestudio",
    "icon": "./assets/hime-icon.png",
    "ios": {
      "bundleIdentifier": "com.himestudio.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "HIME STUDIO needs access to your photo library so you can choose photos and videos of your work for your portfolio."
      }
    },
    "android": {
      "package": "com.himestudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/hime-icon.png",
        "backgroundColor": "#080507"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "HIME STUDIO needs access to your photo library so you can choose photos and videos of your work for your portfolio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
